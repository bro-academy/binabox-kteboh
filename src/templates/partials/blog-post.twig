{% import 'ui/picture.twig' as ui %}
<section class="post">


	<figure
		class="post__figure">
		{# <img src="{{ figure.img }}" alt="{{ figure.alt }}" class="post__image"/> #}
		{{ ui.picture(
					figure.picture.class,
					figure.picture.source,
					figure.picture.alt,
					figure.picture.width,
					figure.picture.height,
					figure.picture.fit
				) }}
		<figcaption class="post__caption">{{ figure.caption }}</figcaption>
	</figure>


	<h2 class="post__tittle">{{ post.title }}</h2>
	<button class="post__button button">{{ post.category }}</button>

	<p class="post__text">
		<svg class="post__icon">
			<use xlink:href="src/assets/icons/sprite.svg#{{ post.author.icon }}"></use>
		</svg>
		<span class="post__address">{{ post.author.name }}
			|</span>
		<time datetime="{{ post.author.date }}">
			<svg class="post__icon-date">
				<use xlink:href="src/assets/icons/sprite.svg#{{ post.author.dateIcon }}"></use>
			</svg>
			{{ post.author.dateFormatted }}</time>
	</p>

	<p class="post__text">
		<span class="{{ post.intro_paragraph.highlight_class }}">{{ post.intro_paragraph.highlight_text }}</span>
		{{ post.intro_paragraph.text_after }}
	</p>

	<ul class="post__menu">
		{% for item in post.bullet_points %}
			<li class="post__item">
				{{ item.text }}
			</li>
		{% endfor %}
	</ul>

	<ul class="post__logos">
		{% for logo in post.feature %}
			<li class="post__logo">
				<a href="#" class="post__logo-item">
					<svg class="post__logo-icon">
						<use xlink:href="src/assets/icons/sprite.svg#{{ logo.icon }}"></use>
					</svg>
					{{ logo.label }}
				</a>
			</li>
		{% endfor %}
	</ul>

	<blockquote class="post__quote post__quote--background">
		"{{ post.quote }}"<br/>
		<span class="post__rating">
			<svg class="post__rating-icon">
				<use xlink:href="src/assets/icons/sprite.svg#{{ post.rating.icon }}"></use>
			</svg>
			{{ post.rating.score }}
			{{ post.rating.source }}
		</span>
	</blockquote>

	{% for figure in post.gallery %}
		<figure class="post__figure">
			<img src="{{ figure.src }}" alt="{{ figure.alt }}" class="post__image"/>
			{{ ui.picture(
						figure.picture.class,
						figure.picture.source,
						figure.picture.alt,
						figure.picture.width,
						figure.picture.height,
						figure.picture.fit
					) }}

			<figcaption class="post__caption">{{ figure.caption }}</figcaption>
		</figure>
	{% endfor %}
	<section class="post">
		<h3 class="post__subtittle">{{ post.nft_intro.title }}</h3>
		<p class="post__text">
			{{ post.nft_intro.paragraph_1 }}
		</p>
		<p class="post__text">
			{{ post.nft_intro.paragraph_2 }}
		</p>

		<h3 class="post__subtittle">{{ post.avatar_generator.title }}</h3>
		<p class="post__text">
			{{ post.avatar_generator.text }}
			<br class="post__line-break"/>
			<span class="post__highlight">
				<a href="{{ post.avatar_generator.link.url }}" class="post__link post__link--color">
					{{ post.avatar_generator.link.label }}
				</a>
			</span>
			{{ post.avatar_generator.call_to_action }}
		</p>
	</section>

	<p class="post__info">Tags:</p>
	<ul class="post__info-menu">
		{% for tag in post.tags %}
			<li class="post__info-item link">
				<a href="#">{{ tag }}</a>
			</li>
		{% endfor %}
	</ul>
	<div class="post__share-wrapper">
		<p class="post__info">Share:</p>
		{% set icons = {
			'Twitter': 'Twitter',
			'facebook': 'facebook',
			'Instagram': 'Instagram'
		} %}
		<ul class="post__info-menu">
			{% for share in post.share %}
				<li class="post__info-item">
					<a href="#" class="post__info-link">
						<svg class="post__info-icon">
							<use xlink:href="src/assets/icons/sprite.svg#{{ icons[share.name] }}"></use>
						</svg>
					</a>
				</li>
			{% endfor %}
		</ul>
	</div>


</section>

