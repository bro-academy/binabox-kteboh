<section class="overview">
	<h2 class="overview__tittle">{{ overview.title }}</h2>

	{% for faq in overview.faqs %}
		<details
			class="overview__item" {% if faq.open %} open {% endif %}>
			{# <summary class="overview__question">{{ faq.question }}
							<span>{{ faq.open ? '−' : '+' }}</span>
						</summary> #}
			<summary class="overview__question">
				{{ faq.question }}

				{% if faq.open %}
					{# Minus icon #}
					<svg class="icon">
						<use xlink:href="src/assets/icons/sprite.svg#minus"></use>
					</svg>
				{% else %}
					{# Plus icon #}
					<svg class="icon">
						<use xlink:href="src/assets/icons/sprite.svg#plus"></use>
					</svg>
				{% endif %}
			</summary>


			{% if faq.answer %}
				<hr class="overview__divider"/>
				<p class="overview__answer">
					{% if faq.term %}
						<span class="overview__term overview__term--color">{{ faq.term }}</span>
					{% endif %}
					{{ faq.answer }}
				</p>
			{% endif %}
		</details>
	{% endfor %}
</section>


