<header class="page-header">
	<nav class="page-header__navigation">
		<a href="#" class="page-header__logo">
			<img src="{{ header.logo }}" alt="{{ header.logoAlt }}"/>
		</a>
		<ul class="page-header__menu">
			{% for item in header.menu %}
				<li class="page-header__item">
					<a href="{{ item.url }}" class="page-header__link-primary {% if item.active %}page-header__link-primary--active{% endif %}">
						{{ item.label }}
						<svg>
							<use xlink:href="src/assets/icons/sprite.svg#Icon_Text (1)"></use>
						</svg>
					</a>
				</li>
			{% endfor %}
		</ul>
	</nav>
	<div class="page-header__form">
		<input class="page-header__search-input" type="text" name="search" id="search" placeholder="{{ header.searchPlaceholder }}"/>
		<a href="{{ header.discord.url }}" class="page-header__link link">
			<svg class="link__icon">
				<use xlink:href="src/assets/icons/sprite.svg#Discord"></use>
			</svg>
			{{ header.discord.label }}
		</a>
		<button class="page-header__button button">
			<svg>
				<use xlink:href="src/assets/icons/sprite.svg#user" width="24px" height="24px"></use>
			</svg>
			{{ header.loginButton }}</button>
	</div>
</header>
